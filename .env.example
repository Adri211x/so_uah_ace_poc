# =============================================================================
# Environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file. It is in .gitignore.
# =============================================================================

# -- Application -------------------------------------------------------------
APP_NAME=so_ua_ace_poc
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# -- Database ----------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# -- Logging -----------------------------------------------------------------
LOG_LEVEL=DEBUG

# -- LiteLLM -----------------------------------------------------------------
LITELLM_API_KEY=sk-...
LITELLM_BASE_URL=https://litellm.doi.azure.datadope.co/v1
LLM_MODEL_NAME=gpt-4o-mini

# -- Langfuse ----------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://langfuse.e2e.so.azure.datadope.co

# -- MCP mock endpoints ------------------------------------------------------
KUBECTL_MCP_URL=http://127.0.0.1:8090/mcp
ELASTICSEARCH_MCP_URL=http://127.0.0.1:8092/mcp
LOKI_MCP_URL=http://127.0.0.1:8093/mcp
TEMPO_MCP_URL=http://127.0.0.1:8094/mcp
PROMETHEUS_MCP_URL=http://127.0.0.1:8095/mcp
