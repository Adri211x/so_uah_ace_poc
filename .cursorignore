# Cursor-specific exclusions
# Patterns in .gitignore are automatically excluded by Cursor

# Large data files that may be tracked in Git but should not be in AI context
data/event_system/cache/
data/event_system/data/datasets/
data/event_system/training_*.json
data/event_system/uv.lock
data/raw/
data/processed/
*.csv
*.parquet
*.json.gz

# Generated documentation (if tracked in Git)
docs/_build/
site/

# Explicitly exclude sensitive files (extra safety layer)
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
secrets/
.secrets

# Temporary analysis or development files
*.tmp
analysis/
scratch/

# Jupyter checkpoints
.ipynb_checkpoints/

# Coverage and profiling
htmlcov/
*.prof
